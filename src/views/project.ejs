<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>


    <section class="project-details">


        <h2>
            <%= project.name %>
        </h2>



        <p>
            <%= project.description %>
        </p>



        <% if (project.location) { %>

            <p>
                Location:
                <%= project.location %>
            </p>

        <% } %>




        <% if (project.date) { %>

            <p>
                Date:
                <%= new Date(project.date).toLocaleDateString() %>
            </p>

        <% } %>




        <% if (project.organization_name) { %>

            <p>
                Partner Organization:

                <a href="/organization/<%= project.organization_id %>">

                    <%= project.organization_name %>

                </a>

            </p>

        <% } %>




        <p>

            <a href="/edit-project/<%= project.project_id %>">

                Edit Project

            </a>

        </p>




        <p>

            <a href="/assign-categories/<%= project.project_id %>">

                Edit Categories

            </a>

        </p>




        <h3>
            Categories
        </h3>


        <% if (categories && categories.length > 0) { %>


            <ul>

                <% categories.forEach(category => { %>


                    <li>

                        <%= category.name %>

                    </li>


                <% }) %>


            </ul>


        <% } else { %>


            <p>
                No categories assigned.
            </p>


        <% } %>




    </section>


</main>


<%- include('partials/footer') %>