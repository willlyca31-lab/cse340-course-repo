<%- include("partials/header") %>


<main>


    <h1>
        <%= title %>
    </h1>




    <% if (project) { %>



    <section class="project-details">



        <h2>
            <%= project.name %>
        </h2>




        <p>
            <%= project.description %>
        </p>




        <h3>
            Partner Organization
        </h3>



        <p>

            <a href="/organization/<%= project.organization_id %>">

                <%= project.organization_name %>

            </a>

        </p>






        <p>

            <a href="/edit-project/<%= project.project_id %>">

                Edit Project

            </a>

        </p>






        <p>

            <a href="/project/<%= project.project_id %>/assign-categories">

                Edit Categories

            </a>

        </p>







        <h3>
            Categories
        </h3>



        <div class="tags">



            <% if(categories && categories.length > 0){ %>




                <% categories.forEach(category=>{ %>



                    <a href="/category/<%= category.category_id %>">

                        <%= category.name %>

                    </a>



                <% }) %>




            <% } else { %>



                <p>
                    No categories assigned.
                </p>



            <% } %>




        </div>





    </section>





    <% } else { %>




        <h2>
            Project Not Found
        </h2>




    <% } %>





</main>



<%- include("partials/footer") %>