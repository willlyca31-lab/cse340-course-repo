<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>


    <form 
        action="/edit-project/<%= project.project_id %>" 
        method="POST"
    >


        <div class="form-group">

            <label for="title">
                Project Name
            </label>


            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.name %>"
                maxlength="150"
                required
            />

        </div>



        <div class="form-group">

            <label for="description">
                Description
            </label>


            <textarea
                id="description"
                name="description"
                maxlength="500"
                required
            ><%= project.description %></textarea>


        </div>




        <div class="form-group">

            <label for="organizationId">
                Organization
            </label>


            <select
                id="organizationId"
                name="organizationId"
                required
            >


                <option value="">
                    Select an organization
                </option>



                <% organizations.forEach(org => { %>


                    <option

                        value="<%= org.organization_id %>"

                        <%= project.organization_id == org.organization_id 
                            ? "selected" 
                            : "" 
                        %>

                    >

                        <%= org.name %>

                    </option>


                <% }) %>


            </select>


        </div>




        <button type="submit">

            Update Project

        </button>


    </form>


</main>


<%- include('partials/footer') %>