<%- include("partials/header") %>


<main>


    <h1>
        <%= title %>
    </h1>



    <form
        action="/edit-project/<%= project.project_id %>"
        method="POST"
    >



        <!-- Project Name -->

        <div class="form-group">


            <label for="title">

                Project Name

            </label>



            <input

                type="text"

                id="title"

                name="title"

                value="<%= project.name %>"

                minlength="3"

                maxlength="200"

                required

            />


        </div>






        <!-- Description -->

        <div class="form-group">


            <label for="description">

                Description

            </label>




            <textarea

                id="description"

                name="description"

                maxlength="1000"

                required

            ><%= project.description %></textarea>




        </div>







        <!-- Organization -->

        <div class="form-group">


            <label for="organization_id">

                Organization

            </label>




            <select

                id="organization_id"

                name="organization_id"

                required

            >



                <% organizations.forEach(org => { %>



                    <option

                        value="<%= org.organization_id %>"

                        <%= 
                        org.organization_id === project.organization_id
                        ? "selected"
                        : ""
                        %>

                    >

                        <%= org.name %>


                    </option>



                <% }) %>



            </select>



        </div>






        <button type="submit">

            Update Project

        </button>




    </form>




</main>



<%- include("partials/footer") %>