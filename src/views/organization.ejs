<%- include("partials/header") %>

<main>

    <h1><%= title %></h1>

    <% if (organization) { %>

    <section class="organization-details">

        <h2><%= organization.name %></h2>

        <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.name %>"
            class="organization-logo"
            width="200"
        >

        <p>
            <%= organization.description %>
        </p>

        <p>
            <strong>Email:</strong>
            <%= organization.contact_email %>
        </p>

        <p>
            <strong>Logo File:</strong>
            <%= organization.logo_filename %>
        </p>

        <p>
            <a class="btn" href="/edit-organization/<%= organization.organization_id %>">
                Edit Organization
            </a>
        </p>

        <p>
            <a class="btn" href="/new-organization">
                Add a New Organization
            </a>
        </p>

        <h3>Service Projects</h3>

        <% if (projects && projects.length > 0) { %>

            <ul>

                <% projects.forEach(project => { %>

                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.name %>
                        </a>
                    </li>

                <% }) %>

            </ul>

        <% } else { %>

            <p>No projects available for this organization.</p>

        <% } %>

    </section>

    <% } else { %>

        <h2>Organization Not Found</h2>

    <% } %>

</main>

<%- include("partials/footer") %>