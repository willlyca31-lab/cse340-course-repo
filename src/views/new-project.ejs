<%- include('partials/header') %>


<main>


    <h1>
        <%= title %>
    </h1>



    <form action="/new-project" method="POST">



        <!-- Project Name -->

        <div class="form-group">


            <label for="title">

                Project Name

            </label>



            <input

                type="text"

                id="title"

                name="title"

                maxlength="200"

                minlength="3"

                required

            />


        </div>





        <!-- Description -->

        <div class="form-group">


            <label for="description">

                Description

            </label>




            <textarea

                id="description"

                name="description"

                maxlength="1000"

                required

            ></textarea>



        </div>






        <!-- Organization -->

        <div class="form-group">


            <label for="organization_id">

                Organization

            </label>




            <select

                id="organization_id"

                name="organization_id"

                required

            >



                <option value="">

                    Select an organization

                </option>



                <% organizations.forEach(org => { %>



                    <option

                        value="<%= org.organization_id %>"

                    >

                        <%= org.name %>

                    </option>



                <% }) %>



            </select>



        </div>







        <button type="submit">

            Create Project

        </button>




    </form>




</main>



<%- include('partials/footer') %>