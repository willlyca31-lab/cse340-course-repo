<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
        <link rel="icon" href="/favicon.ico" sizes="32x32">
        <link rel="stylesheet" href="/css/main.css">
    </head>
    <body>
        <nav class="site-nav">
            <a class="site-brand" href="/" aria-label="CSE 340 Service Network home">
                <img src="/images/cse340-service-network.png" alt="CSE 340 Service Network logo">
            </a>
            <ul class="nav-links">
                <li><a class="<%= currentPath === '/' ? 'nav-cta' : '' %>" href="/">Home</a></li>
                <li><a class="<%= currentPath.startsWith('/organization') ? 'nav-cta' : '' %>" href="/organizations">Organizations</a></li>
                <li><a class="<%= currentPath.startsWith('/project') ? 'nav-cta' : '' %>" href="/projects">Projects</a></li>
                <li><a class="<%= currentPath.startsWith('/categor') ? 'nav-cta' : '' %>" href="/categories">Categories</a></li>
                <% if (isLoggedIn) { %>
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/logout">Logout</a></li>
                <% } else { %>
                <li><a href="/register">Register</a></li>
                <li><a href="/login">Login</a></li>
                <% } %>
            </ul>
        </nav>

        <% const messages = flash(); %>
        <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            <div class="alert <%= type %>">
                <% messages[type].forEach((message) => { %>
                    <p><%= message %></p>
                <% }); %>
                </div>
            <% } %>
            <% }); %>

</header>
